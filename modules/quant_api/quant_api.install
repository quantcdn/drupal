<?php

/**
 * @file
 * Install, update and uninstall functions for the Quant API module.
 */

use Drupal\Core\Url;
use Drupal\quant_api\OAuth\Platform;

/**
 * Implements hook_requirements().
 */
function quant_api_requirements($phase) {
  if ($phase !== 'runtime') {
    return [];
  }
  $credentials = \Drupal::service('quant_api.credentials');
  if (!$credentials->usesOauth()) {
    return [];
  }
  if (!$credentials->isCopiedSite()) {
    $reason = \Drupal::service('quant_api.oauth')->getReconnectReason();
    if ($reason === NULL) {
      return [];
    }
    return [
      'quant_api_login' => [
        'title' => t('Quant'),
        'value' => t('The Quant login needs renewing'),
        'description' => t('Content still publishes. Log in to Quant again on the <a href=":url">Quant API settings page</a> to keep the connection current.', [
          ':url' => Url::fromRoute('quant_api.settings_form')->toString(),
        ]),
        'severity' => REQUIREMENT_WARNING,
      ],
    ];
  }
  return [
    'quant_api_copied_site' => [
      'title' => t('Quant'),
      'value' => t('Not publishing: this site looks like a copy of the connected site'),
      'description' => t('Different: @components. Log in to Quant again, or confirm that it is the same site on the <a href=":url">Quant API settings page</a>.', [
        '@components' => implode(', ', $credentials->copyDifferences()),
        ':url' => Url::fromRoute('quant_api.settings_form')->toString(),
      ]),
      'severity' => REQUIREMENT_ERROR,
    ],
  ];
}

/**
 * Implements hook_uninstall().
 */
function quant_api_uninstall() {
  // The OAuth connection is outside config, so config removal leaves it.
  $store = \Drupal::service('quant_api.oauth_store');
  $store->clear();
  $store->deleteAllPendingLogins();
}

/**
 * Add the platform and the connection method to the Quant API settings.
 */
function quant_api_update_11001() {
  $config = \Drupal::configFactory()->getEditable('quant_api.settings');
  if (!Platform::isKnown($config->get('platform'))) {
    $config->set('platform', Platform::fromEndpoint($config->get('api_endpoint')));
  }
  if (!in_array($config->get('auth_method'), ['token', 'oauth'], TRUE)) {
    $config->set('auth_method', 'token');
  }
  $config->save();
}
