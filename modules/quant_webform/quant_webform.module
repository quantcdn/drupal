<?php

/**
 * @file
 * Quant Forms support for Webform.
 */

use Drupal\Component\Utility\Xss;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\quant_webform\ExportContext;
use Drupal\quant_webform\Plugin\WebformElement\QuantWizardPage;
use Drupal\quant_webform\QuantFormsMapper;
use Drupal\webform\WebformInterface;

/**
 * Implements hook_theme().
 */
function quant_webform_theme() {
  return [
    'quant_form_result' => [
      'render element' => 'element',
    ],
  ];
}

/**
 * Implements hook_library_info_alter().
 */
function quant_webform_library_info_alter(&$libraries, $extension) {
  // Webform files support auto-upload and validation via ajax.
  // The js/css libraries are not relevant for static forms via Quant.
  if ($extension === 'webform') {
    if (isset($libraries['webform.element.managed_file'])) {
      unset($libraries['webform.element.managed_file']);
    }
  }
}

/**
 * Implements hook_webform_element_info_alter().
 */
function quant_webform_webform_element_info_alter(array &$definitions) {
  // An export render shows every wizard page; a live render is unchanged.
  if (isset($definitions['webform_wizard_page'])) {
    $definitions['webform_wizard_page']['class'] = QuantWizardPage::class;
  }
}

/**
 * Implements hook_webform_submission_form_alter().
 */
function quant_webform_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  // The export render and the live render differ, so they must not share a
  // render cache entry. The page cache is handled by ExportRequestPolicy.
  $form['#cache']['contexts'][] = 'headers:quant-token';
  if (!ExportContext::isExport()) {
    return;
  }
  /** @var \Drupal\webform\WebformSubmissionInterface $submission */
  $submission = $form_state->getFormObject()->getEntity();
  $webform = $submission->getWebform();
  if (!$webform->getThirdPartySetting('quant_webform', 'enabled', TRUE)) {
    return;
  }

  $form['#attributes']['data-quant-webform'] = $webform->id();
  _quant_webform_add_result_container($form, $webform);
  _quant_webform_static_actions($form, $webform);
  $form['#attached']['library'][] = 'quant_webform/static_form';
  $form['#attached']['drupalSettings']['quantWebform'][$webform->id()] = _quant_webform_settings($webform);
}

/**
 * Adds the element that Quant fills with its result message.
 */
function _quant_webform_add_result_container(array &$form, WebformInterface $webform) {
  foreach ($webform->getElementsDecodedAndFlattened() as $element) {
    if (($element['#type'] ?? '') === 'quant_result_element') {
      return;
    }
  }
  $form['quant_form_result'] = [
    '#theme' => 'quant_form_result',
    '#weight' => -1000,
  ];
}

/**
 * Keeps only the buttons that work on a static page.
 *
 * The wizard and preview buttons ask Drupal for the next page, and drafts
 * and uploads post to Drupal. The browser steps replace them.
 */
function _quant_webform_static_actions(array &$form, WebformInterface $webform) {
  if (!isset($form['actions'])) {
    return;
  }
  foreach (['wizard_prev', 'wizard_next', 'preview_prev', 'preview_next', 'draft', 'reset'] as $button) {
    if (isset($form['actions'][$button])) {
      $form['actions'][$button]['#access'] = FALSE;
    }
  }
  if (isset($form['actions']['submit'])) {
    // Webform hides submit until the last page; the browser steps show it.
    $form['actions']['submit']['#access'] = TRUE;
    $form['actions']['submit']['#attributes']['data-quant-submit'] = 'true';
  }
}

/**
 * The drupalSettings of one static form.
 */
function _quant_webform_settings(WebformInterface $webform) {
  $type = (string) $webform->getSetting('confirmation_type');
  $settings = [
    'wizard' => $webform->hasWizardPages(),
    'preview' => (int) $webform->getSetting('preview') > 0,
    'labels' => [
      'prev' => (string) ($webform->getSetting('wizard_prev_button_label') ?: t('Back')),
      'next' => (string) ($webform->getSetting('wizard_next_button_label') ?: t('Continue')),
      'review' => (string) ($webform->getSetting('preview_next_button_label') ?: t('Review')),
      'edit' => (string) ($webform->getSetting('preview_prev_button_label') ?: t('Edit')),
      'previewTitle' => (string) ($webform->getSetting('preview_label') ?: t('Review')),
      'sending' => (string) t('Sending…'),
      'error' => (string) t('Your submission could not be sent. Please try again.'),
      'required' => (string) t('Complete this field.'),
      'step' => (string) t('Step @current of @total'),
    ],
    'confirmation' => [
      'type' => in_array($type, ['url', 'url_message'], TRUE) ? 'url' : 'message',
      'title' => (string) $webform->getSetting('confirmation_title'),
      'message' => Xss::filterAdmin(_quant_webform_static_message($webform)),
      'url' => _quant_webform_confirmation_url($webform),
    ],
  ];
  return $settings;
}

/**
 * The confirmation message for the browser, without Webform tokens.
 */
function _quant_webform_static_message(WebformInterface $webform) {
  $override = (string) $webform->getThirdPartySetting('quant_webform', 'success_message', '');
  $message = $override !== '' ? $override : (string) $webform->getSetting('confirmation_message');
  return QuantFormsMapper::stripTokens($message) ?: (string) t('Thank you. Your submission has been received.');
}

/**
 * The address a url confirmation redirects to, or an empty string.
 */
function _quant_webform_confirmation_url(WebformInterface $webform) {
  if (!in_array($webform->getSetting('confirmation_type'), ['url', 'url_message'], TRUE)) {
    return '';
  }
  $url = trim((string) $webform->getSetting('confirmation_url'));
  if ($url === '' || str_contains($url, '[')) {
    return '';
  }
  try {
    return str_starts_with($url, '/') || preg_match('#^https?://#', $url)
      ? $url
      : Url::fromUserInput('/' . ltrim($url, '/'))->toString();
  }
  catch (\Exception $e) {
    return '';
  }
}

/**
 * Implements hook_webform_insert().
 */
function quant_webform_webform_insert(WebformInterface $webform) {
  quant_webform_webform_update($webform);
}

/**
 * Implements hook_webform_update().
 */
function quant_webform_webform_update(WebformInterface $webform) {
  if (!_quant_webform_can_publish()) {
    return;
  }
  /** @var \Drupal\quant_webform\QuantFormsRegistrar $registrar */
  $registrar = \Drupal::service('quant_webform.registrar');
  $registered = $webform->getThirdPartySetting('quant_webform', 'enabled', TRUE);
  if (!$webform->isOpen() || !$registered) {
    // A closed or unregistered form stops taking submissions on Quant.
    $registrar->disable($registrar->pages($webform));
    if ($webform->isOpen()) {
      $registrar->pushNow($webform);
    }
    return;
  }
  $registrar->pushNow($webform);
}

/**
 * Implements hook_webform_predelete().
 */
function quant_webform_webform_predelete(WebformInterface $webform) {
  if (!_quant_webform_can_publish()) {
    return;
  }
  // The pages are known only while the Webform exists.
  $registrar = \Drupal::service('quant_webform.registrar');
  $registrar->disable($registrar->pages($webform));
}

/**
 * Whether saves publish: a connection exists and config sync is not running.
 */
function _quant_webform_can_publish() {
  if (\Drupal::isConfigSyncing()) {
    return FALSE;
  }
  return \Drupal::service('quant_api.credentials')->hasToken();
}

/**
 * Implements hook_webform_third_party_settings_form_alter().
 */
function quant_webform_webform_third_party_settings_form_alter(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\webform\WebformInterface $webform */
  $webform = $form_state->getFormObject()->getEntity();
  $form['third_party_settings']['quant_webform'] = [
    '#type' => 'details',
    '#title' => t('Quant Forms'),
    '#open' => TRUE,
    '#description' => t('On the static site, Quant takes the submissions of this form, stores them and sends the notifications.'),
    'enabled' => [
      '#type' => 'checkbox',
      '#title' => t('Take submissions through Quant Forms'),
      '#default_value' => $webform->getThirdPartySetting('quant_webform', 'enabled', TRUE),
    ],
    'success_message' => [
      '#type' => 'textarea',
      '#title' => t('Message after a submit on the static site'),
      '#description' => t('Leave empty to use the confirmation message without its tokens. Quant shows at most 256 characters of plain text when JavaScript is off.'),
      '#default_value' => $webform->getThirdPartySetting('quant_webform', 'success_message', ''),
      '#rows' => 3,
    ],
    'slack' => [
      '#type' => 'checkbox',
      '#title' => t('Send a Slack notification'),
      '#description' => t('Uses the Slack webhook on the Quant Forms settings page.'),
      '#default_value' => $webform->getThirdPartySetting('quant_webform', 'slack', TRUE),
    ],
    'report' => \Drupal::service('quant_webform.report')->build($webform),
  ];
}
