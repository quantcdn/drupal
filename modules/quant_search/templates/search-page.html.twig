<div class="quant-search">

    {%if page.description %}
    <h4>{{ page.description }}</h4>
    {% endif %}

    {% if page.display.results.display_search %}
    <div id="searchbox" class="ais-SearchBox"></div>
    {% endif %}

    <div class="flex-grid">

        {% if facets is not empty %}
        {# Open by default; quant-search.js folds it away on narrow screens. #}
        <details class="col facets" open>
            <summary class="facets-toggle">{{ 'Filter results'|t }}</summary>

            {% if page.display.results.show_clear_refinements %}
            <div id="clear-refinements"></div>
            {% endif %}

            {% for facet in facets %}
            <div class="facet-container" role="group" aria-labelledby="facet-heading-{{ facet.facet_container }}">
                <div class="facet-heading" id="facet-heading-{{ facet.facet_container }}">{{ facet.facet_heading }}</div>
                <div id="facet_{{ facet.facet_container }}"></div>
            </div>
            {% endfor %}
        </details>
        {% endif %}

        <div class="col content">
            {% if page.display.results.display_stats %}
            <div id="stats" role="status"></div>
            {% endif %}

            <div id="hits"></div>

            {% if page.display.pagination.pagination_enabled %}
            <div id="pagination"></div>
            {% endif %}
        </div>
    </div>
</div>
